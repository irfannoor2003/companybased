APP_NAME="Nexos Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Absolute paths to the MySQL client binaries used by Settings > Backup &
# Restore. Leave blank to let the app auto-detect them (it probes the usual
# Laragon, XAMPP and Linux locations, then falls back to the system PATH).
# A configured path that does not exist is ignored, so a Windows path left
# behind is harmless on a Linux host.
MYSQLDUMP_PATH=
MYSQL_CLIENT_PATH=

# How many .sql dumps to keep in storage/app/backups. After each successful
# backup the oldest are deleted, so the directory cannot grow without bound.
BACKUP_KEEP=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL is required. SQLite is used only for the test suite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yourdatabase
DB_USERNAME=youruser
DB_PASSWORD=yourpassword

# Throwaway schema used ONLY by the test suite, which runs migrate:fresh against
# it. It must never be the same name as DB_DATABASE: the suite drops every table
# it finds. Tests\TestCase refuses to run if it resolves to anything that is not
# obviously a test database. Create it once with:
#   CREATE DATABASE companybased_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_TEST_DATABASE=companybased_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Jobs are drained by cron running `schedule:run` every minute. Without that
# cron entry no queued notification is ever delivered.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Optional second login for the team mailbox (info@) on the same SMTP host.
# Normally set these from Settings > Mail Server instead of here.
MAIL_TEAM_USERNAME=null
MAIL_TEAM_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
